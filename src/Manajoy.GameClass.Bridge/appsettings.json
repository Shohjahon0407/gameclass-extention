{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bridge": {
    "Server": "(local)",
    "Database": "GameClass",
    "Provider": "Auto",
    "SqlLogin": {
      "UserName": null,
      "Password": null
    },
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 15,
    "PollIntervalSeconds": 5,
    "HttpUrls": "http://127.0.0.1:8787",
    "ApiKey": null,
    "SnapshotFile": "output/snapshot.json",
    "EventLogFile": "output/events.jsonl",
    "LogDirectory": "logs",
    "MaxEventsInMemory": 1000
  }
}
